# Modelo de variáveis de ambiente para PRODUÇÃO. Copie para a configuração
# de ambiente do host de deploy (ex.: Vercel → Project Settings →
# Environment Variables) — NUNCA copie para um arquivo .env versionado.
#
# NENHUM valor real deste arquivo deve ser commitado. Todos os
# placeholders abaixo precisam ser substituídos por valores reais gerados
# fora deste repositório. Ver docs/production-runbook.md para o
# procedimento completo de cada item.
#
# Validação: lib/env/production-env.ts falha o boot da aplicação
# (instrumentation.ts) se qualquer variável obrigatória estiver ausente
# ou inválida quando NODE_ENV=production. A mensagem de erro cita só o
# NOME da variável, nunca o valor.

# --- Supabase (projeto de PRODUÇÃO, nunca o local) ---------------------

# URL do projeto Supabase de produção. Precisa ser https e não pode ser
# localhost/127.0.0.1 (validado no boot).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-REF.supabase.co

# Chave anônima do projeto de produção (pública, respeita RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role do projeto de produção. SEGREDO — nunca
# NEXT_PUBLIC_, nunca exposta ao navegador, nunca usada fora de rotas
# server-only/scripts administrativos read-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação -----------------------------------------------------------

# URL pública real do domínio de produção. Precisa ser https e não pode
# ser localhost (validado no boot). Usada para montar links absolutos
# (confirmação de e-mail, recuperação de senha) — precisa bater
# exatamente com o Site URL/Redirect URLs cadastrados no Supabase Auth de
# produção (ver docs/production-runbook.md, seção "Auth").
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO-REAL.com.br

# --- Pagamentos (Pix / Mercado Pago) --------------------------------------

# Chave AES-256-GCM (32 bytes em base64) usada para criptografar as
# credenciais Mercado Pago de cada loja. SEGREDO. Gere uma chave NOVA e
# exclusiva de produção (nunca reaproveite a de dev/staging):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: trocar esta chave depois que já existem credenciais
# criptografadas no banco INVALIDA a leitura delas — ver procedimento de
# rotação em docs/production-runbook.md antes de qualquer troca.
PAYMENT_ENCRYPTION_KEY=

# Deve ficar AUSENTE (ou qualquer valor diferente de "fake") em produção.
# "fake" nunca é aceito com NODE_ENV=production — a aplicação recusa subir
# (lib/payments/gateway/select-mode.ts) e o release:check também verifica
# isso estaticamente. Não defina esta variável em produção.
# PAYMENT_GATEWAY_MODE=

# --- Cron de reconciliação -------------------------------------------------

# Protege POST /api/cron/payments/reconcile (Authorization: Bearer
# <CRON_SECRET>). SEGREDO — gere um valor aleatório exclusivo de produção:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Opcionais (mesma semântica do .env.example de desenvolvimento) ------

# CAPTCHA real (hCaptcha/Turnstile) — ver checklist em docs/handoff.md
# antes de ativar em produção.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Bloqueio de senhas vazadas (HIBP, k-anonimato). Requer acesso à
# internet a partir do servidor.
HIBP_PASSWORD_CHECK_ENABLED=false

# SÓ true se o host de deploy (ex.: Vercel) garantidamente SOBRESCREVE
# x-forwarded-for/x-real-ip com o IP real do cliente. Confirme antes de
# ativar — ver comentário completo em .env.example.
TRUSTED_PROXY_ENABLED=false
