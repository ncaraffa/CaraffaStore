# Copie este arquivo para .env.local e preencha com valores do SEU Supabase
# local (via `npx supabase start`) ou de um projeto de desenvolvimento isolado.
# NUNCA coloque credenciais reais de produção aqui nem em .env.local versionado.

# URL do projeto Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave anônima (publica, respeita RLS) — segura para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Chave de service role — NUNCA exposta ao cliente, usada apenas em
# scripts de seed/dev locais (scripts/seed-local.ts). Nunca usar em
# código que responde a requisições de usuário.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# URL pública do app, usada para montar/validar destinos internos de
# redirecionamento (confirmação de e-mail, recuperação de senha, "next").
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# CAPTCHA (T2-DEC-011: preparado para cadastro/recuperação, sem
# obrigação de ativar no dev local). Deixe ENABLED=false localmente.
# Para ativar em produção: criar conta no provedor, preencher os
# valores reais e espelhar em supabase/config.toml [auth.captcha].
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Bloqueio de senhas vazadas (Have I Been Pwned, k-anonimato — nenhuma
# senha completa sai da máquina). O Supabase local (self-hosted) não
# expõe essa opção em supabase/config.toml; esta é a preparação em
# nível de aplicação. Requer acesso à internet quando ativado — deixe
# false em ambientes isolados/CI.
HIBP_PASSWORD_CHECK_ENABLED=false

# Rate limiting (lib/auth/rate-limit.ts): SÓ ative se o app estiver
# atrás de um proxy/edge que SOBRESCREVE x-forwarded-for/x-real-ip com o
# IP real do cliente (nunca repassa o que o cliente original enviou).
# Deixe false/ausente sempre que não tiver essa garantia — nesse caso o
# app ignora esses headers de propósito (evita que o próprio cliente
# forje um IP novo a cada tentativa para escapar do limite; ver
# qa/reports/TASK-002.md, BUG-T2-005). Confirme o comportamento real do
# proxy do ambiente de deploy antes de ligar isto.
TRUSTED_PROXY_ENABLED=false

# TASK-005 — Pix e pagamentos (Mercado Pago). Chave AES-256-GCM (32 bytes
# em base64) usada para criptografar Access Token/Webhook Secret de cada
# loja antes de gravar no banco — gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA reutilize a mesma chave entre ambientes, NUNCA commite o valor
# real, NUNCA use NEXT_PUBLIC_.
PAYMENT_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

# "fake" usa FakePixGateway (sem chamada de rede real) — só para
# desenvolvimento/teste local. Deixe ausente (ou qualquer outro valor)
# para usar o Mercado Pago real. NUNCA "fake" em produção — a aplicação
# recusa essa combinação (lib/payments/gateway/index.ts).
PAYMENT_GATEWAY_MODE=fake

# Protege POST /api/cron/payments/reconcile (Authorization: Bearer
# <CRON_SECRET>) — gere um valor aleatório próprio, nunca reutilize entre
# ambientes.
CRON_SECRET=replace-with-a-random-secret
