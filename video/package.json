{
  "name": "caraffastore-product-film",
  "version": "1.0.0",
  "private": true,
  "description": "Product film da CaraffaStore (Remotion). Projeto isolado: nada aqui entra no bundle da aplicação.",
  "scripts": {
    "studio": "remotion studio",
    "render:master": "remotion render ProductFilm out/caraffastore-product-film-master.mp4 --codec=h264 --crf=16",
    "render:web": "remotion render ProductFilm out/caraffastore-product-film-web.mp4 --codec=h264 --crf=26",
    "render:webm": "remotion render ProductFilm out/caraffastore-product-film.webm --codec=vp9 --crf=34",
    "render:poster": "remotion still ProductFilm out/caraffastore-product-film-poster.png --frame=60",
    "render:all": "npm run render:master && npm run render:web && npm run render:webm && npm run render:poster"
  },
  "dependencies": {
    "@remotion/cli": "4.0.410",
    "@remotion/google-fonts": "4.0.410",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.410"
  },
  "devDependencies": {
    "@types/react": "19.0.7",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}
