{
  "name": "caraffastore-product-film",
  "version": "1.0.0",
  "private": true,
  "description": "Product film da CaraffaStore (Remotion). Projeto isolado: nada aqui entra no bundle da aplicação.",
  "scripts": {
    "studio": "remotion studio",
    "render:desktop:master": "remotion render CaraffaStoreProductFilmDesktop out/caraffastore-product-film-desktop-master.mp4 --codec=h264 --crf=16 --muted",
    "render:desktop:web": "remotion render CaraffaStoreProductFilmDesktop out/caraffastore-product-film-desktop-web.mp4 --codec=h264 --crf=27 --muted",
    "render:desktop:webm": "remotion render CaraffaStoreProductFilmDesktop out/caraffastore-product-film-desktop.webm --codec=vp9 --crf=34 --muted",
    "render:desktop:poster": "remotion still CaraffaStoreProductFilmDesktop out/caraffastore-product-film-desktop-poster.jpeg --frame=0 --image-format=jpeg --jpeg-quality=90",
    "render:mobile:master": "remotion render CaraffaStoreProductFilmMobile out/caraffastore-product-film-mobile-master.mp4 --codec=h264 --crf=16 --muted",
    "render:mobile:web": "remotion render CaraffaStoreProductFilmMobile out/caraffastore-product-film-mobile-web.mp4 --codec=h264 --crf=27 --muted",
    "render:mobile:webm": "remotion render CaraffaStoreProductFilmMobile out/caraffastore-product-film-mobile.webm --codec=vp9 --crf=34 --muted",
    "render:mobile:poster": "remotion still CaraffaStoreProductFilmMobile out/caraffastore-product-film-mobile-poster.jpeg --frame=0 --image-format=jpeg --jpeg-quality=90",
    "render:desktop": "npm run render:desktop:master && npm run render:desktop:web && npm run render:desktop:webm && npm run render:desktop:poster",
    "render:mobile": "npm run render:mobile:master && npm run render:mobile:web && npm run render:mobile:webm && npm run render:mobile:poster",
    "render:all": "npm run render:desktop && npm run render:mobile",
    "preview": "node preview/serve.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.410",
    "@remotion/google-fonts": "4.0.410",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.410"
  },
  "devDependencies": {
    "@types/react": "19.0.7",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}
